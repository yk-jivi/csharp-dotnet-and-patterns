<UserControl x:Class="BookStore.StarRatingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <StackPanel Orientation="Horizontal">
        <Button x:Name="Star1" Content="☆" FontSize="20" Width="25" Click="Star_Click" Tag="1"
                Background="Transparent" BorderThickness="0" Cursor="Hand"/>
        <Button x:Name="Star2" Content="☆" FontSize="20" Width="25" Click="Star_Click" Tag="2"
                Background="Transparent" BorderThickness="0" Cursor="Hand"/>
        <Button x:Name="Star3" Content="☆" FontSize="20" Width="25" Click="Star_Click" Tag="3"
                Background="Transparent" BorderThickness="0" Cursor="Hand"/>
        <Button x:Name="Star4" Content="☆" FontSize="20" Width="25" Click="Star_Click" Tag="4"
                Background="Transparent" BorderThickness="0" Cursor="Hand"/>
        <Button x:Name="Star5" Content="☆" FontSize="20" Width="25" Click="Star_Click" Tag="5"
                Background="Transparent" BorderThickness="0" Cursor="Hand"/>
    </StackPanel>
</UserControl>