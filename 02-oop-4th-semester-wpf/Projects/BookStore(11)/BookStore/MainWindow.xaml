<Window x:Class="BookStore.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BookStore"
        Cursor="/custom.cur"
        Title="Книжный магазин" Height="750" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        x:Name="ThisWindow">

    <Window.CommandBindings>
        <CommandBinding Command="local:BookCommands.ClearCartCommand"
                        Executed="ClearCart_Executed"
                        CanExecute="ClearCart_CanExecute"/>
    </Window.CommandBindings>

    <Window.Resources>
        <local:ImagePathConverter x:Key="ImagePathConverter"/>
        <local:BytesToImageConverter x:Key="ImageConverter"/>

        <!-- Добавляем конвертер для Boolean -> Visibility -->
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#dddddd"/>
            <Setter Property="Padding" Value="10,5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                    <Setter Property="Background" Value="#fff0f0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Text.Length, RelativeSource={RelativeSource Self}}" Value="5">
                    <Setter Property="Background" Value="#b1b3b1"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Text.Length, RelativeSource={RelativeSource Self}}" Value="5"/>
                        <Condition Binding="{Binding IsFocused, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка с поиском -->
        <Border x:Name="HeaderBorder" Grid.Row="0" Background="{DynamicResource HeaderBrush}" CornerRadius="10" Padding="15" Margin="0,0,0,10">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TitleText" Text="{DynamicResource Title}" 
                              FontSize="24" FontWeight="Bold" Foreground="White"
                              VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Border Background="{DynamicResource HeaderButtonBrush}" CornerRadius="5" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="UserModeBtn" Content="{DynamicResource UserMode}" 
                                       Style="{StaticResource WhiteButtonStyle}" Width="120"
                                       Command="{Binding SwitchToUserModeCommand}"/>
                                <Button x:Name="AdminModeBtn" Content="{DynamicResource AdminMode}" 
                                       Style="{StaticResource GreenButtonStyle}" Width="120"
                                       Command="{Binding SwitchToAdminModeCommand}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource HeaderButtonBrush}" CornerRadius="5" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="UndoBtn" Content="←" Style="{StaticResource WhiteButtonStyle}"
                                       Width="40" Command="{Binding UndoCommand}" ToolTip="Отменить"/>
                                <Button x:Name="RedoBtn" Content="→" Style="{StaticResource GreenButtonStyle}"
                                       Width="40" Command="{Binding RedoCommand}" ToolTip="Повторить"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="AccountBtn" Content="Личный кабинет" Style="{StaticResource WhiteButtonStyle}"
                               Width="128" Margin="0,0,10,0" Command="{Binding OpenAccountCommand}" ToolTip="Личный кабинет"/>

                        <Border Background="{DynamicResource HeaderButtonBrush}" CornerRadius="5">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="RussianLangBtn" Content="RU" Style="{StaticResource WhiteButtonStyle}"
                                       Width="50" Command="{Binding ChangeLanguageCommand}" CommandParameter="ru"/>
                                <Button x:Name="EnglishLangBtn" Content="EN" Style="{StaticResource GreenButtonStyle}"
                                       Width="50" Command="{Binding ChangeLanguageCommand}" CommandParameter="en"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <TextBox x:Name="SearchBox" Style="{StaticResource SearchBoxStyle}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </Border>

        <!-- Фильтры с кнопками переключения вида -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" 
                Padding="15" Margin="0,0,0,10" BorderBrush="#dddddd" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="CategoryFilter" 
                         ItemsSource="{Binding Categories}"
                         SelectedIndex="{Binding CategoryFilterSelectedIndex}"
                         Margin="0,0,10,0" Height="35"/>

                <ComboBox x:Name="SortFilter" Grid.Column="1"
                         ItemsSource="{Binding SortOptions}"
                         SelectedIndex="{Binding SortFilterSelectedIndex}"
                         Margin="0,0,10,0" Height="35"/>

                <Button x:Name="SwitchToListBtn" Grid.Column="3" Content="Список" 
                       Style="{StaticResource GreenButtonStyle}" Width="80" Height="35" Margin="10,0,0,0"
                       Command="{Binding SwitchToListViewCommand}"/>
                <Button x:Name="SwitchToTileBtn" Grid.Column="4" Content="Плитка" 
                       Style="{StaticResource WhiteButtonStyle}" Width="80" Height="35" Margin="5,0,0,0"
                       Command="{Binding SwitchToTileViewCommand}"/>
            </Grid>
        </Border>

        <!-- Основной контент -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Панель для переключения вида книг -->
            <Grid Grid.Column="0">
                <!-- Вид списком (ListView) -->
                <ScrollViewer x:Name="ListViewPanel" VerticalScrollBarVisibility="Auto"
                             Visibility="{Binding IsListViewVisible, Converter={StaticResource BoolToVisConverter}}">
                    <ListView x:Name="BooksListView" 
                              Background="Transparent"
                              BorderThickness="0"
                              SelectionMode="Single"
                              SelectedItem="{Binding SelectedBook}"
                              ItemsSource="{Binding FilteredBooks}"
                              HorizontalContentAlignment="Stretch">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" 
                                       Padding="15" Margin="0,0,0,10" BorderBrush="#dddddd" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.RowSpan="2" Width="60" Height="80" Background="#e8f0e8" 
                                                CornerRadius="5" Margin="0,0,15,0" BorderBrush="{DynamicResource PrimaryBrush}"
                                                BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Image Source="{Binding ImageBytes, Converter={StaticResource ImageConverter}}"
                                                Width="58" Height="78" Stretch="UniformToFill" Margin="1"/>
                                        </Border>

                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Title}" 
                                                  FontSize="18" FontWeight="Bold" 
                                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                                  Margin="0,0,0,5" TextWrapping="Wrap"/>

                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="{Binding Author}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,15,0"/>
                                            <TextBlock Text="{Binding Category}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" 
                                                   Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Price, StringFormat={}{0} BYN}" 
                                                     FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"
                                                     HorizontalAlignment="Right"/>
                                            <Button Content="{DynamicResource Details}" Style="{StaticResource GreenButtonStyle}"
                                                   Margin="0,5,0,0" Width="100" Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </ScrollViewer>

                <!-- Вид плиткой (BookCardControl) -->
                <ScrollViewer x:Name="TileViewPanel" VerticalScrollBarVisibility="Auto"
                             Visibility="{Binding IsTileViewVisible, Converter={StaticResource BoolToVisConverter}}">
                    <ItemsControl x:Name="BooksTileControl" ItemsSource="{Binding FilteredBooks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <local:BookCardControl DataContext="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Корзина -->
            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" 
                   Padding="15" BorderBrush="#dddddd" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="CartTitle" Text="{DynamicResource Cart}" 
                              FontSize="20" FontWeight="Bold" 
                              Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,15"/>

                    <ScrollViewer Grid.Row="1" Margin="0,0,0,15">
                        <ItemsControl x:Name="CartListView" ItemsSource="{Binding Cart}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#f5f5f5" CornerRadius="5" Padding="10" Margin="0,0,0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="{Binding Book.Title}" FontWeight="Bold" 
                                                         Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                    <TextBlock Text="{Binding Book.Price, StringFormat={}{0} BYN}" 
                                                             Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,10,0"/>
                                                    <TextBlock Text="x" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding Quantity}" Foreground="{DynamicResource TextSecondaryBrush}" 
                                                             Margin="5,0,0,0" FontWeight="Bold"/>
                                                    <TextBlock Text="=" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,0,10,0"/>
                                                    <TextBlock Text="{Binding TotalPrice, StringFormat={}{0} BYN}" 
                                                             Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <Button Grid.Column="1" Content="✖" Style="{StaticResource GreenButtonStyle}"
                                                   Width="30" Height="30" Padding="0" Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Book.Id}" ToolTip="Удалить из корзины"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2">
                        <Separator Background="#dddddd" Height="2" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TotalText" Text="{DynamicResource Total}" 
                                     FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="TotalAmount" Grid.Column="1" Text="{Binding TotalAmount}" 
                                     FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                        </Grid>
                        <TextBlock Text="{Binding CartItemsCount}" 
                                  Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" HorizontalAlignment="Right"/>
                        <Button x:Name="CheckoutBtn" Content="{DynamicResource Checkout}" 
                               Style="{StaticResource GreenButtonStyle}" Height="40" Margin="0,0,0,5" Command="{Binding CheckoutCommand}"/>

                        <Button Content="Очистить корзину (Ctrl+Delete)" 
                                Command="{Binding ClearCartCommand}"
                                Style="{StaticResource WhiteButtonStyle}"
                                Height="40"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Окно с подробной информацией -->
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="20"
               Width="450" HorizontalAlignment="Left" VerticalAlignment="Top"
               Visibility="{Binding IsDetailsPopupVisible, Converter={StaticResource BoolToVisConverter}}"
               BorderBrush="#dddddd" BorderThickness="1" Margin="362,24,0,0" Grid.RowSpan="2" Grid.Row="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="DetailsTitle" Text="{Binding DetailsTitle}" FontSize="22" FontWeight="Bold" 
                              Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Button Grid.Column="1" Content="✖" Style="{StaticResource GreenButtonStyle}"
                           Width="30" Height="30" Padding="0" Command="{Binding CloseDetailsCommand}"/>
                </Grid>

                <Border Grid.Row="1" Background="#f5f5f5" CornerRadius="5" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DetailsAuthorLabel" Text="{DynamicResource Author}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="DetailsAuthor" Grid.Column="1" Text="{Binding DetailsAuthor}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DetailsCategoryLabel" Text="{DynamicResource Category}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="DetailsCategory" Grid.Column="1" Text="{Binding DetailsCategory}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DetailsYearLabel" Text="{DynamicResource Year}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="DetailsYear" Grid.Column="1" Text="{Binding DetailsYear}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DetailsPagesLabel" Text="{DynamicResource Pages}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="DetailsPages" Grid.Column="1" Text="{Binding DetailsPages}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DetailsPriceLabel" Text="{DynamicResource Price}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="DetailsPrice" Grid.Column="1" Text="{Binding DetailsPrice}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" FontSize="18"/>
                        </Grid>
                        <TextBlock x:Name="DetailsDescription" Text="{Binding DetailsDescription}" TextWrapping="Wrap" Margin="0,10,0,0" 
                                  Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <Button x:Name="AddToCartFromDetails" Grid.Row="2" Content="{DynamicResource AddToCart}" 
                       Style="{StaticResource GreenButtonStyle}" Height="40" FontSize="14" 
                       Command="{Binding AddToCartCommand}" CommandParameter="{Binding CurrentDetailsBook}"/>
            </Grid>
        </Border>

        <!-- Админ панель -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" 
                Padding="15" Margin="0,10,0,0" BorderBrush="#dddddd" BorderThickness="1"
                Visibility="{Binding IsAdminPanelVisible, Converter={StaticResource BoolToVisConverter}}">
            <StackPanel>
                <TextBlock Text="Просмотр таблиц:" FontWeight="SemiBold" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                    <Button Content="Книги" Command="{Binding NavigateBooksCommand}" Width="120" Margin="5,0" Style="{StaticResource GreenButtonStyle}"/>
                    <Button Content="Категории" Command="{Binding NavigateCategoriesCommand}" Width="120" Margin="5,0" Style="{StaticResource GreenButtonStyle}"/>
                    <Button Content="Заказы" Command="{Binding NavigateOrdersCommand}" Width="120" Margin="5,0" Style="{StaticResource GreenButtonStyle}"/>
                </StackPanel>

                <Separator Margin="0,5,0,15" Background="#eeeeee"/>

                <TextBlock Text="Действия с записями:" FontWeight="SemiBold" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="AddBookBtn" Content="{DynamicResource AddBook}" Style="{StaticResource GreenButtonStyle}"
                            Width="150" Margin="0,0,10,0" Command="{Binding AddBookCommand}"/>
                    <Button x:Name="EditBookBtn" Content="{DynamicResource EditBook}" Style="{StaticResource GreenButtonStyle}"
                            Width="150" Margin="0,0,10,0" Command="{Binding EditBookCommand}"/>
                    <Button x:Name="DeleteBookBtn" Content="{DynamicResource DeleteBook}" Style="{StaticResource GreenButtonStyle}"
                            Width="150" Command="{Binding DeleteBookCommand}"/>
                </StackPanel>

                <DataGrid AutoGenerateColumns="True" IsReadOnly="True" 
                          MaxHeight="250" Margin="0,15,0,0"
                          Visibility="{Binding IsMainDataGridVisible, Converter={StaticResource BoolToVisConverter}}"
                          ItemsSource="{Binding DataGridSource.Items}"/>
            </StackPanel>
        </Border>

        <!-- Диалог добавления/редактирования книги -->
        <Border Grid.Row="1" Grid.RowSpan="3" Grid.ColumnSpan="2"
                Background="White" CornerRadius="10" Padding="20"
                Width="500" HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="{Binding IsBookDialogVisible, Converter={StaticResource BoolToVisConverter}}"
                BorderBrush="#dddddd" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding DialogTitleText}" FontSize="20" FontWeight="Bold" 
                          Foreground="#333333" Margin="0,0,0,15"/>

                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource TitleField}" Foreground="#333333" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding DialogTitleInput}" Grid.Column="1"/>
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource AuthorField}" Foreground="#333333" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding DialogAuthorInput}" Grid.Column="1"/>
                </Grid>

                <Grid Grid.Row="3" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource CategoryField}" Foreground="#333333" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding Categories}" SelectedIndex="{Binding DialogCategorySelectedIndex}" Grid.Column="1"/>
                </Grid>

                <Grid Grid.Row="4" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource YearField}" Foreground="#333333" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding DialogYearInput}" Grid.Column="1"/>
                </Grid>

                <Grid Grid.Row="5" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource PagesField}" Foreground="#333333" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding DialogPagesInput}" Grid.Column="1"/>
                </Grid>

                <Grid Grid.Row="6" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource PriceField}" Foreground="#333333" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding DialogPriceInput}" Grid.Column="1"/>
                </Grid>

                <StackPanel Margin="0,10">
                    <TextBlock Text="Обложка:" Foreground="Gray" Margin="0,0,0,5"/>
                    <Button Content="Выбрать файл..." Command="{Binding SelectImageCommand}" 
                            Style="{StaticResource GreenButtonStyle}" Width="150" HorizontalAlignment="Left"/>
                </StackPanel>

                <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{DynamicResource Save}" Style="{StaticResource GreenButtonStyle}"
                            Width="100" Margin="0,0,10,0" Command="{Binding SaveBookDialogCommand}"/>
                    <Button Content="{DynamicResource Cancel}" Style="{StaticResource WhiteButtonStyle}"
                            Width="100" Command="{Binding CancelBookDialogCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>